{
  "name": "seked",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Survey-accurate 3D model of the Giza necropolis with the encoded-mathematics claims as live overlays",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "bundle": "tsx scripts/bundle.ts",
    "web-assets": "tsx scripts/web-assets.ts",
    "dev:web": "pnpm bundle && python scripts/web-textures.py && pnpm web-assets && pnpm --filter @seked/web dev",
    "build:web": "pnpm bundle && python scripts/web-textures.py && pnpm web-assets && pnpm --filter @seked/web build",
    "site": "pnpm build:web && tsx scripts/site.ts",
    "courses": "tsx scripts/courses.ts",
    "claim": "tsx scripts/claim.ts",
    "dossier": "tsx scripts/dossier.ts",
    "shafts": "tsx scripts/shafts.ts",
    "sky-bake": "tsx scripts/sky-bake.ts",
    "sky-rollback": "tsx scripts/sky-rollback.ts",
    "stars": "tsx scripts/stars.ts",
    "footprints": "tsx scripts/footprints.ts",
    "city": "tsx scripts/city.ts",
    "props": "python scripts/props.py && tsx scripts/web-assets.ts",
    "deploy": "pnpm build:web && pnpm site && cd site && npx --yes wrangler@4.20.0 pages deploy . --project-name seked --branch main --commit-dirty=true"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.0",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@seked/claims": "workspace:*",
    "@seked/data": "workspace:*",
    "@seked/geometry": "workspace:*",
    "@seked/runner": "workspace:*",
    "@seked/sky": "workspace:*",
    "@seked/units": "workspace:*",
    "@types/node": "^26.5.1",
    "meshoptimizer": "^1.2.0",
    "sharp": "^0.35.4",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
