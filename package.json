{
  "name": "seked",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Survey-accurate 3D model of the Giza necropolis with the encoded-mathematics claims as live overlays",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "bundle": "tsx scripts/bundle.ts",
    "dev:web": "pnpm bundle && pnpm --filter @seked/web dev",
    "build:web": "pnpm bundle && pnpm --filter @seked/web build",
    "site": "pnpm build:web && tsx scripts/site.ts",
    "courses": "tsx scripts/courses.ts",
    "dossier": "tsx scripts/dossier.ts",
    "shafts": "tsx scripts/shafts.ts",
    "sky-bake": "tsx scripts/sky-bake.ts",
    "sky-rollback": "tsx scripts/sky-rollback.ts",
    "stars": "tsx scripts/stars.ts",
    "footprints": "tsx scripts/footprints.ts"
  },
  "devDependencies": {
    "@seked/claims": "workspace:*",
    "@seked/data": "workspace:*",
    "@seked/geometry": "workspace:*",
    "@seked/sky": "workspace:*",
    "@seked/units": "workspace:*",
    "@types/node": "^26.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
