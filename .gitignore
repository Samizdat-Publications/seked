# Node
node_modules/
dist/
.turbo/
*.log

# Blender
*.blend1
*.blend2
blender/**/cache/
__pycache__/
build/

# Large generated assets are tracked with LFS once the pipeline exists
*.glb
*.gltf
# except the Meshy generations chosen for the manifest, which Meshy does not keep and
# Git LFS carries to every machine (.gitattributes; python scripts/meshy.py share)
!assets/meshy/*.glb
*.ktx2
*.tif
*.tiff

# Downloaded by hand for `pnpm stars`; see data/sources.json, source hyg-4.2
data/stars/hyg_v42.csv
data/stars/hyg_v42.csv.gz

# Fetched from Overpass by `pnpm run footprints`; see data/sources.json, source osm-2026
data/footprints/overpass-giza.json

# Written by `pnpm bundle` from data/
apps/web/public/seked.json
apps/web/public/terrain/
apps/web/public/city/
apps/web/public/textures/
apps/web/public/sky/

# Written by `pnpm web-assets` from the GLBs blender/export_web.py bakes
apps/web/public/models/

# Written by the props pass of `pnpm web-assets` from build/props/
apps/web/public/props/

# Local
.env
.env.*
.DS_Store

# Plugin scratch data and agent worktrees
.claude/data/
.claude/worktrees/
.playwright-mcp/
site/

# Stage 6: the city archives are caches, not data. A 1.3 GB footprint
# tile and 1.2 GB height rasters; what is committed is the clipped result.
build/city/

# The walkthrough's rendered panoramas and frames are build outputs
apps/walk/pano/
apps/walk/img/
apps/walk/films/
apps/films/films/
# Downloaded by hand for `pnpm run icecore`; see data/sources.json, source gicc05-ngrip-20yr
data/icecore/gicc05-20yr.txt
